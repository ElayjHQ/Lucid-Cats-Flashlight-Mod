<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>LucidCatsFlashlight</AssemblyName>
    <RootNamespace>LucidCatsFlashlight</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.1.0</Version>
    <!-- Where Lucid Cats is installed. Override with the LUCID_CATS_DIR environment
         variable or /p:GameDir="..." if the game lives somewhere else. -->
    <GameDir Condition="'$(GameDir)' == ''">$([System.Environment]::GetEnvironmentVariable('LUCID_CATS_DIR'))</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">A:\SteamLibrary\steamapps\common\Lucid Cats</GameDir>
    <NoWarn>1701;1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Mono">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.Unity.Mono.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\LucidCats_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\LucidCats_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameDir)\LucidCats_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameDir)\LucidCats_Data\Managed\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(GameDir)\LucidCats_Data\Managed\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(GameDir)\LucidCats_Data\Managed\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(GameDir)\LucidCats_Data\Managed\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>$(GameDir)\LucidCats_Data\Managed\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(GameDir)\LucidCats_Data\Managed\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Netcode.Runtime">
      <HintPath>$(GameDir)\LucidCats_Data\Managed\Unity.Netcode.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Collections">
      <HintPath>$(GameDir)\LucidCats_Data\Managed\Unity.Collections.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\LucidCats_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HaniUtils.Core">
      <HintPath>$(GameDir)\LucidCats_Data\Managed\HaniUtils.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HaniUtils.NGO">
      <HintPath>$(GameDir)\LucidCats_Data\Managed\HaniUtils.NGO.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HaniUtils.Gameplay">
      <HintPath>$(GameDir)\LucidCats_Data\Managed\HaniUtils.Gameplay.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- After building: install into the game (when present) and refresh the
       repo's package payload so the installer always ships the latest DLL. -->
  <Target Name="InstallToPlugins" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\core')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Audio\flashlight_open.mp3" DestinationFolder="$(GameDir)\BepInEx\plugins\LucidCatsFlashlight\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Audio\flashlight_close.mp3" DestinationFolder="$(GameDir)\BepInEx\plugins\LucidCatsFlashlight\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildThisFileDirectory)..\..\package\LucidCatsFlashlightMod\BepInEx\plugins\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Audio\flashlight_open.mp3" DestinationFolder="$(MSBuildThisFileDirectory)..\..\package\LucidCatsFlashlightMod\BepInEx\plugins\LucidCatsFlashlight\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Audio\flashlight_close.mp3" DestinationFolder="$(MSBuildThisFileDirectory)..\..\package\LucidCatsFlashlightMod\BepInEx\plugins\LucidCatsFlashlight\" SkipUnchangedFiles="true" />
  </Target>

</Project>
